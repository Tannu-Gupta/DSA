class Solution {
public:
    bool isCovered(vector<vector<int>>& ranges, int left, int right) {
        vector<int> a(right+1);
        for(auto i : ranges){
            for(int j=i[0]; j<=i[1] && j<=right; j++) 
                a[j]++;
        }
        for(int i=left; i<=right; i++){
            if(a[i] == 0) return false;
        }
        return true;
    }
};
