class Solution {
public:
    int findTargetSumWays(vector<int>& nums, int target) {

        int sum = 0;

        for (int x : nums)
            sum += x;

        // Target is impossible
        if (abs(target) > sum)
            return 0;

        // (sum + target) must be even
        if ((sum + target) % 2 != 0)
            return 0;

        int newTarget = (sum + target) / 2;

        // dp[j] = number of ways to make sum j
        vector<int> dp(newTarget + 1, 0);

        dp[0] = 1;

        for (int num : nums) {

            // Traverse backwards because
            // every number can be used only once
            for (int j = newTarget; j >= num; j--) {

                dp[j] += dp[j - num];
            }
        }

        return dp[newTarget];
    }
};
