class Solution {
public:
    vector<vector<int>> graph;
    vector<int> ans;
    vector<int> quiet;

    int dfs(int person) {
        // If already computed, return it
        if (ans[person] != -1)
            return ans[person];

        // Initially, the quietest person is himself
        ans[person] = person;

        // Check all richer people
        for (int richerPerson : graph[person]) {
            int candidate = dfs(richerPerson);

            // Update if candidate is quieter
            if (quiet[candidate] < quiet[ans[person]]) {
                ans[person] = candidate;
            }
        }

        return ans[person];
    }

    vector<int> loudAndRich(vector<vector<int>>& richer, vector<int>& quiet) {
        int n = quiet.size();

        this->quiet = quiet;
        graph.resize(n);
        ans.assign(n, -1);

        // Build graph:
        // poorer -> richer
        for (auto &edge : richer) {
            int rich = edge[0];
            int poor = edge[1];
            graph[poor].push_back(rich);
        }

        // Run DFS for every person
        for (int i = 0; i < n; i++) {
            dfs(i);
        }

        return ans;
    }
};
