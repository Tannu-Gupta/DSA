class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        int n = nums.size();

        sort(nums.begin(), nums.end());

        vector<int> ans;

        for(int i=1; i<n; i++){
            for(int x = nums[i-1]+1; x<nums[i]; x++){
                ans.push_back(x);
            }
        }

        return ans;
    }
};
