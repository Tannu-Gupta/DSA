class Solution {
public:
    bool carPooling(vector<vector<int>>& trips, int capacity) {

        vector<int> change(1001, 0);

        for (int i = 0; i < trips.size(); i++) {

            int passengers = trips[i][0];
            int from = trips[i][1];
            int to = trips[i][2];

            change[from] += passengers;
            change[to] -= passengers;
        }

        int current = 0;

        for (int i = 0; i <= 1000; i++) {

            current += change[i];

            if (current > capacity)
                return false;
        }

        return true;
    }
};
