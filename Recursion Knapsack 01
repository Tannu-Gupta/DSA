#include <iostream>
#include <vector>
using namespace std;


      //Recursion
double knapsack01_Rec(vector<vector<int>>& items, int W, int n){   //wt, val
    if(n == 0 || W == 0) return 0;

    int val = items[n-1][0];
    int wt = items[n-1][1];

    if(wt <= W){
        double include = val + knapsack01_Rec(items, W - wt, n - 1);
        double exclude = knapsack01_Rec(items, W, n - 1);
        return max(include, exclude);
    } else {
        return knapsack01_Rec(items, W, n - 1);
    }
}

int main(){
    vector<vector<int>> items = {{20, 2}, {30, 3}, {50, 4}, {60, 5}, {100, 9}};

    int W = 10;
    cout << knapsack01_Rec(items, W, items.size()) << endl;

    return 0;
}
