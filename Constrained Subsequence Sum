class Solution {
public:
    int constrainedSubsetSum(vector<int>& nums, int k) {
        int n = nums.size();
        vector<int> dp(n);

        int sum = nums[0];
        for(int i=0; i<n; i++){
            dp[i] = nums[i];

            for(int j=max(0, i-k); j<i; j++){
                dp[i] = max(dp[i], nums[i] + dp[j]);
            }
            sum = max(sum, dp[i]);
        }
        return sum;
    }
};
