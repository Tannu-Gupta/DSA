class Solution {
public:
    vector<vector<long long>> splitPainting(vector<vector<int>>& segments) {
        vector<long long> diff(100002, 0);

        for(auto s : segments){
            diff[s[0]] += s[2];
            diff[s[1]] -= s[2];
        }

        vector<vector<long long>> ans;
        long long color = 0;
        int start = 0;

        for(int i = 1; i < 100002; i++){
            if(diff[i] != 0){
                if(color > 0)
                    ans.push_back({start, i, color});

                color += diff[i];
                start = i;
            }
        }

        return ans;
    }
};
