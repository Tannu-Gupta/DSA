class Solution {
public:
    string shiftingLetters(string s, vector<vector<int>>& shifts) {
        int n = s.size();
        vector<int> diff(n+1, 0);

        //Mark changes
        for(auto shift : shifts){
            if(shift[2] == 1){      //+1
                diff[shift[0]]++;
                diff[shift[1]+1]--;
            }
            else {           //-1
                 diff[shift[0]]--; 
                  diff[shift[1]+1]++;
            }
        }
         //Prefix sum
         for(int i=1; i<=n; i++)
          diff[i] += diff[i-1];

          string ans;
          for(int i=0; i<n; i++){
            int count = diff[i] % 26;
            if(count < 0)
               count = 26 + count;

               char curr = char((s[i] -'a' + count) % 26 + 97);
               ans.push_back(curr);
          }
          return ans;
    }
};
