#include <iostream>
#include <vector>
using namespace std;

//Fibonacci DP code //Memoized
int fibDP(int n, vector<int> &f){   //TC:O(n)
    if(n <= 1) return n;

    if(f[n] != -1){
        return f[n];
    }

    return f[n] = fibDP(n-1, f) + fibDP(n-2, f);
}

//Fibonacci DP code //Tabulation
int fibTabDp(int n){
    vector<int> dp(n+1);

    dp[0] = 0;
    dp[1] = 1;
    
    for(int i=2; i<=n; i++){
        dp[i] = dp[i-1] + dp[i-2];
    }
    return dp[n];
}

