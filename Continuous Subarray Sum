class Solution {
public:
    bool checkSubarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        int sum = 0;

        unordered_map<int, int> mp;
        mp[0] = 0;

        for(int i=0; i<n; i++){
            sum = (sum + nums[i]) % k;
            if(mp.find(sum) != mp.end()){
                if(i+1 - mp[sum] >= 2) return true;
            }
            else{
                mp[sum] = i+1;
            }
        }
        return false;
    }
};
